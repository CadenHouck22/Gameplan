server <- function(input, output) {
  
  filtered_recs <- reactive({
    pitch_recs %>%
      filter(
        pitcher == input$pitcher,
        batter_hand == input$batter_hand
      ) %>%
      arrange(desc(projected_csw))
  })
  
  best_rec <- reactive({
    recs <- filtered_recs()
    
    if (nrow(recs) == 0) {
      return(NULL)
    }
    
    recs %>%
      slice(1)
  })
  
  output$best_pitch <- renderText({
    rec <- best_rec()
    
    if (is.null(rec)) {
      return("N/A")
    }
    
    rec$recommended_pitch
  })
  
  output$projected_csw <- renderText({
    rec <- best_rec()
    
    if (is.null(rec)) {
      return("N/A")
    }
    
    paste0(round(rec$projected_csw * 100, 1), "%")
  })
  
  output$risk_level <- renderText({
    rec <- best_rec()
    
    if (is.null(rec)) {
      return("N/A")
    }
    
    rec$risk_level
  })
  
  output$recommendation_text <- renderText({
    rec <- best_rec()
    
    if (is.null(rec)) {
      return("No recommendation available for this combination yet.")
    }
    
    paste0(
      "For ", input$pitcher, " against a ", input$batter_hand,
      "-handed hitter, the recommended pitch is ", rec$recommended_pitch,
      " located ", rec$location, ". The projected CSW probability is ",
      round(rec$projected_csw * 100, 1), "%."
    )
  })
  
  output$recommendation_table <- renderDT({
    filtered_recs() %>%
      mutate(projected_csw = round(projected_csw * 100, 1)) %>%
      rename(
        Pitcher = pitcher,
        Batter_Hand = batter_hand,
        Count = count,
        Previous_Pitch = previous_pitch,
        Recommended_Pitch = recommended_pitch,
        Location = location,
        Projected_CSW_Percent = projected_csw,
        Risk_Level = risk_level
      )
  })
  
  filtered_arsenal <- reactive({
    arsenal_data %>%
      filter(pitcher == input$pitcher)
  })
  
  output$usage_plot <- renderPlotly({
    p <- filtered_arsenal() %>%
      ggplot(aes(x = reorder(pitch_type, usage), y = usage)) +
      geom_col() +
      coord_flip() +
      labs(
        x = "Pitch Type",
        y = "Usage %",
        title = paste(input$pitcher, "Pitch Usage")
      ) +
      theme_minimal()
    
    ggplotly(p)
  })
  
  output$arsenal_table <- renderDT({
    filtered_arsenal() %>%
      rename(
        Pitcher = pitcher,
        Pitch_Type = pitch_type,
        Usage_Percent = usage,
        Average_Velocity = avg_velocity,
        Average_CSW = avg_csw
      )
  })
  
  output$count_table <- renderDT({
    pitch_recs %>%
      filter(pitcher == input$pitcher) %>%
      group_by(count, recommended_pitch) %>%
      summarize(
        avg_projected_csw = mean(projected_csw),
        .groups = "drop"
      ) %>%
      arrange(count, desc(avg_projected_csw)) %>%
      mutate(avg_projected_csw = round(avg_projected_csw * 100, 1)) %>%
      rename(
        Count = count,
        Recommended_Pitch = recommended_pitch,
        Average_Projected_CSW = avg_projected_csw
      )
  })
}

shinyApp(ui = ui, server = server)
